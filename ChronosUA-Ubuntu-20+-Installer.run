#!/usr/bin/env bash
# =============================================================================
# ChronosUA - Ubuntu 20.04 / 22.04 / 24.04+ Self-Extracting Installer
# Usage: chmod +x ChronosUA-Ubuntu-20+-Installer.run && ./ChronosUA-Ubuntu-20+-Installer.run
# =============================================================================
set -e

INSTALL_DIR="$HOME/.local/share/chronosua"
BIN_DIR="$HOME/.local/bin"
DESKTOP_DIR="$HOME/.local/share/applications"

if [ "$(id -u)" -eq 0 ]; then
    INSTALL_DIR="/opt/chronosua"
    BIN_DIR="/usr/local/bin"
    DESKTOP_DIR="/usr/share/applications"
fi

echo "======================================================================"
echo " Installing ChronosUA OPC UA Simulation Server for Ubuntu 20.04+..."
echo " Target Directory: $INSTALL_DIR"
echo "======================================================================"

if ! command -v java >/dev/null 2>&1; then
    echo "[*] Java Runtime not detected. Installing default-jre via apt..."
    if [ "$(id -u)" -eq 0 ]; then
        apt-get update && apt-get install -y default-jre
    elif command -v sudo >/dev/null 2>&1; then
        sudo apt-get update && sudo apt-get install -y default-jre
    else
        echo "[!] Please install OpenJDK (sudo apt install default-jre) and re-run."
        exit 1
    fi
fi

mkdir -p "$INSTALL_DIR" "$BIN_DIR" "$DESKTOP_DIR"
TMP_TAR="$(mktemp /tmp/chronosua_payload.XXXXXX.tar.gz)"
cat << 'PAYLOAD_EOF' | base64 -d > "$TMP_TAR"

PAYLOAD_EOF

tar -xzf "$TMP_TAR" -C "$INSTALL_DIR"
rm -f "$TMP_TAR"

cat > "$BIN_DIR/chronosua" << LAUNCH_EOF
#!/usr/bin/env bash
exec java -Xmx512m -jar "$INSTALL_DIR/chronosua-server.jar" "\$@"
LAUNCH_EOF
chmod +x "$BIN_DIR/chronosua"

cat > "$DESKTOP_DIR/chronosua.desktop" << DESK_EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=ChronosUA OPC UA Server
Comment=Enterprise OPC UA Simulation & Delayed Write Server
Exec=$BIN_DIR/chronosua
Terminal=false
Categories=Development;Engineering;
DESK_EOF
chmod +x "$DESKTOP_DIR/chronosua.desktop" || true

echo "[+] Installation Complete! Starting ChronosUA Server & UI..."
nohup "$BIN_DIR/chronosua" >/tmp/chronosua.log 2>&1 &
sleep 1
echo "======================================================================"
echo " ChronosUA is now RUNNING!"
echo " • Web UI (All 6 Screens): http://localhost:8080"
echo " • OPC UA Endpoint       : opc.tcp://localhost:4840/chronos"
echo "======================================================================"
